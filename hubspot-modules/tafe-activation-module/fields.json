      {
        "id": "faq_1_question",
        "name": "faq_1_question",
        "label": "FAQ 1 - Question",
        "required": false,
        "locked": false,
        "type": "text",
        "default": "What is Tools™ & how can it help me?"
      },
      {
        "id": "faq_1_answer",
        "name": "faq_1_answer",
        "label": "FAQ 1 - Answer",
        "required": false,
        "locked": false,
        "type": "textarea",
        "default": "Tools™ is a platform that transforms complex Building Codes & Australian Standards (AS) into clear, interactive graphics. It helps users quickly understand & apply building regulations, saving time & improving accuracy."
      },
      {
        "id": "faq_2_question",
        "name": "faq_2_question",
        "label": "FAQ 2 - Question",
        "required": false,
        "locked": false,
        "type": "text",
        "default": "Can I access Tools™ on mobile devices?"
      },
      {
        "id": "faq_2_answer",
        "name": "faq_2_answer",
        "label": "FAQ 2 - Answer",
        "required": false,
        "locked": false,
        "type": "textarea",
        "default": "Yes, Tools™ can be accessed via the web platform & mobile apps. While the web platform offers full functionality, the mobile app is designed for quick viewing & on-the-go access."
      }
    ]
